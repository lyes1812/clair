# URL PostgreSQL (sur Scalingo : SCALINGO_POSTGRESQL_URL est lue si DATABASE_URL est absente)
DATABASE_URL=postgres://clair:clair@localhost:5432/clair
# Secret de signature des sessions : 32 octets aléatoires minimum
BETTER_AUTH_SECRET=
# URL publique de l'application
BETTER_AUTH_URL=http://localhost:3000
# Domaines ouverts à l'inscription sans invitation (comptes de recette uniquement ; vide en production)
CLAIR_SIGNUP_ALLOWED_DOMAINS=
